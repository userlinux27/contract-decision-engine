# env.example - Copy to .env and fill in values
# Local development environment variables

# LLM Configuration
LLM_PROVIDER=stub          # stub | openai | ollama
LLM_MODEL=gpt-4o-mini      # Model name for OpenAI
OPENAI_API_KEY=            # Required if LLM_PROVIDER=openai
OLLAMA_HOST=http://host.docker.internal:11434  # For Ollama in Docker Desktop

# API Limits
API_RATE_LIMIT=10          # Requests per minute per IP
MAX_FILE_SIZE_MB=10        # Max PDF upload size
TASK_TTL_HOURS=24          # Task cleanup interval

# Security
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO