<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Should I sign this contract?</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0f0f13; color: #e4e4e7;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            padding: 20px;
        }
        .container { max-width: 700px; width: 100%; text-align: center; }
        h1 { font-size: 2.2rem; font-weight: 700; line-height: 1.2; margin-bottom: 12px; }
        .subtitle { font-size: 1.1rem; color: #a1a1aa; margin-bottom: 36px; }
        .upload-zone {
            border: 2px dashed #27272a; border-radius: 16px; padding: 50px 30px;
            margin-bottom: 28px; cursor: pointer; background: #18181b;
        }
        .upload-zone:hover, .upload-zone.dragover { border-color: #6366f1; background: #1e1e24; }
        .upload-zone .icon { font-size: 2.8rem; margin-bottom: 12px; }
        .upload-zone .text { font-size: 1.1rem; font-weight: 500; }
        .upload-zone .hint { font-size: 0.85rem; color: #71717a; margin-top: 6px; }
        .upload-btn {
            padding: 14px 38px; font-size: 1.1rem; font-weight: 600;
            background: #6366f1; color: white; border: none; border-radius: 12px;
            cursor: pointer; display: inline-block; margin-top: 8px;
        }
        .upload-btn:hover { background: #5558e6; }
        .demo-section { margin-top: 36px; padding-top: 28px; border-top: 1px solid #27272a; }
        .demo-section p { color: #71717a; margin-bottom: 12px; font-size: 0.9rem; }
        .demo-links { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .demo-link {
            padding: 10px 18px; border: 1px solid #27272a; border-radius: 10px;
            color: #a1a1aa; text-decoration: none; font-size: 0.9rem; cursor: pointer;
        }
        .demo-link:hover { border-color: #6366f1; color: #e4e4e7; }
        .hidden { display: none; }
        #file-input { display: none; }
        .status {
            margin-top: 24px; padding: 20px; border-radius: 12px;
            background: #18181b; font-size: 1rem; color: #a1a1aa;
        }
        .status .spinner {
            display: inline-block; width: 20px; height: 20px;
            border: 2px solid #27272a; border-top-color: #6366f1;
            border-radius: 50%; animation: spin 0.8s linear infinite;
            margin-right: 10px; vertical-align: middle;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .report { text-align: left; margin-top: 24px; }
        .card {
            background: #18181b; border-radius: 16px; padding: 24px;
            margin-bottom: 16px; border: 1px solid #27272a;
        }
        .badge {
            display: inline-block; padding: 6px 16px; border-radius: 100px;
            font-weight: 600; font-size: 0.9rem;
        }
        .badge.ready { background: #065f46; color: #6ee7b7; }
        .badge.review { background: #78350f; color: #fbbf24; }
        .badge.high { background: #7f1d1d; color: #fca5a5; }
        .meta-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
            margin: 16px 0; font-size: 0.9rem; color: #a1a1aa;
        }
        .meta-item { background: #1a1a1e; padding: 12px; border-radius: 10px; }
        .meta-item .label { font-size: 0.75rem; color: #71717a; text-transform: uppercase; }
        .meta-item .value { font-size: 1rem; margin-top: 4px; color: #e4e4e7; }
        .section-title { font-weight: 600; margin: 20px 0 8px; color: #e4e4e7; }
        .list { list-style: none; padding: 0; color: #a1a1aa; }
        .list li { padding: 4px 0; }
        .notice {
            background: #1a1a1e; border-left: 3px solid #fbbf24; padding: 12px 16px;
            border-radius: 8px; margin: 12px 0; color: #fbbf24; font-size: 0.9rem;
        }
        .finding-detail {
            background: #1a1a1e; border-radius: 10px; padding: 16px; margin-bottom: 12px;
        }
        .finding-detail .llm-label { font-size: 0.8rem; color: #71717a; text-transform: uppercase; }
        .finding-detail .llm-text { margin: 4px 0 12px; color: #a1a1aa; }
        .copy-btn {
            padding: 6px 14px; background: #27272a; border: none; border-radius: 6px;
            color: #a1a1aa; cursor: pointer; font-size: 0.8rem; transition: background 0.2s;
        }
        .copy-btn:hover { background: #3f3f46; }
        .copy-btn.copied { background: #065f46; color: #6ee7b7; }
        .whats-next {
            background: #1a1a1e; border-radius: 12px; padding: 16px;
            margin-top: 12px;
        }
        .whats-next a { color: #6366f1; text-decoration: none; }
        .whats-next a:hover { text-decoration: underline; }
        .early-access-btn {
            padding: 12px 28px; font-size: 1rem; font-weight: 600;
            background: #fbbf24; color: #0f0f13; border: none; border-radius: 10px;
            cursor: pointer; margin-top: 12px;
        }
        .early-access-btn:hover { background: #f59e0b; }
        .feedback-buttons { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
        .feedback-btn {
            padding: 10px 18px; border: 1px solid #27272a; border-radius: 8px;
            background: transparent; color: #a1a1aa; cursor: pointer;
            font-size: 0.9rem; transition: all 0.2s;
        }
        .feedback-btn:hover { border-color: #6366f1; color: #e4e4e7; }
        .feedback-btn.selected { background: #6366f1; border-color: #6366f1; color: white; }
        .debug-info {
            margin-top: 28px; padding: 16px; background: #0f0f13; border-radius: 10px;
            border: 1px solid #27272a; font-size: 0.8rem; color: #52525b;
        }
        .footer-note { margin-top: 32px; font-size: 0.8rem; color: #52525b; }
                /* New: Info blocks */
        .info-blocks {
            display: flex;
            gap: 32px;
            margin-top: 40px;
            padding-top: 32px;
            border-top: 1px solid #27272a;
            justify-content: center;
            text-align: left;
        }

        .info-block {
            flex: 1;
            max-width: 280px;
        }

        .info-block h3 {
            font-size: 0.85rem;
            font-weight: 600;
            color: #e4e4e7;
            margin-bottom: 8px;
            letter-spacing: 0.3px;
        }

        .info-block p {
            font-size: 0.8rem;
            color: #71717a;
            line-height: 1.5;
        }

        @media (max-width: 480px) {
            .info-blocks {
                flex-direction: column;
                gap: 24px;
                align-items: center;
            }
            .info-block {
                max-width: 100%;
                text-align: center;
            }
        }@media (max-width: 480px) {
            h1 { font-size: 1.8rem; }
            .demo-links { flex-direction: column; }
            .meta-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div id="main-screen">
            <h1>Should I sign this contract?</h1>
            <p class="subtitle">Upload your service agreement and get a clear suggested decision.</p>
            <div class="upload-zone" id="upload-zone">
                <div class="icon">📄</div>
                <div class="text">Drop your contract here</div>
                <div class="hint">PDF only • Max 10 MB</div>
            </div>
            <input type="file" id="file-input" accept=".pdf">
            <button class="upload-btn" id="upload-btn">Analyze my contract</button>
            <div class="demo-section">
                <p>Or try a demo:</p>
                <div class="demo-links">
                    <span class="demo-link" data-demo="safe">🟢 Ready to Sign</span>
                    <span class="demo-link" data-demo="changes">🟡 Review Recommended</span>
                    <span class="demo-link" data-demo="reject">🔴 High Risk</span>
                </div>
            </div>
            <p style="margin-top: 28px;"><a href="about.html" style="color:#6366f1;">About this service</a></p>
            <p style="margin-top: 8px; font-size: 0.8rem; color: #52525b;">Questions or feedback? <a href="mailto:feedback@workmatic.pro" style="color:#6366f1;">feedback@workmatic.pro</a></p>
            <p class="footer-note">Based on detected issues. This is not legal advice.</p>
            
            <div class="info-blocks">
                <div class="info-block">
                    <h3>What we check</h3>
                    <p>We look for key contract risks such as termination terms, fees and penalties, liability, payment terms, jurisdiction, unilateral changes and other clauses that may deserve a closer look.</p>
                </div>
                <div class="info-block">
                    <h3>Privacy matters</h3>
                    <p>Your PDF is processed temporarily on our server and removed after processing. Relevant contract excerpts identified during the analysis may be sent to our external AI provider to generate explanations.</p>
                </div>
            </div>
        </div>
        <div id="loading-screen" class="hidden">
            <div class="status"><span class="spinner"></span> <span id="loading-text">Uploading…</span></div>
        </div>
        <div id="result-screen" class="hidden report"></div>
    </div>

    <script>
        let visitorId = localStorage.getItem('visitor_id') || crypto.randomUUID();
        localStorage.setItem('visitor_id', visitorId);

        const mainScreen = document.getElementById('main-screen');
        const loadingScreen = document.getElementById('loading-screen');
        const resultScreen = document.getElementById('result-screen');
        const loadingText = document.getElementById('loading-text');
        const uploadZone = document.getElementById('upload-zone');
        const fileInput = document.getElementById('file-input');
        const uploadBtn = document.getElementById('upload-btn');

        uploadBtn.addEventListener('click', () => fileInput.click());
        uploadZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => { if (e.target.files[0]) uploadFile(e.target.files[0]); });

        uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover'); });
        uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
        uploadZone.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadZone.classList.remove('dragover');
            if (e.dataTransfer.files[0]) uploadFile(e.dataTransfer.files[0]);
        });
        document.addEventListener('dragover', (e) => e.preventDefault());
        document.addEventListener('drop', (e) => e.preventDefault());

        document.querySelectorAll('.demo-link').forEach(link => {
            link.addEventListener('click', () => loadDemo(link.dataset.demo));
        });

        async function uploadFile(file) {
            if (!file.name.toLowerCase().endsWith('.pdf')) { alert('Please upload a PDF file.'); return; }
            showLoading('Uploading…');
            const formData = new FormData(); formData.append('file', file);
            try {
                const resp = await fetch('/analyze', { method: 'POST', body: formData });
                const data = await resp.json();
                if (!resp.ok) { showError(data.error || 'Unknown error'); return; }
                showPipelineResult(data);
            } catch (err) { showError('Network error. Please try again.'); }
        }

        async function loadDemo(type) {
            showLoading('Loading demo…');
            await new Promise(r => setTimeout(r, 1200));
            const resp = await fetch(`/analyze/${type}`);
            const data = await resp.json();
            showResult(data);
        }

        function showLoading(text) {
            mainScreen.classList.add('hidden'); resultScreen.classList.add('hidden');
            loadingScreen.classList.remove('hidden'); loadingText.textContent = text;
        }

        function showMain() {
            loadingScreen.classList.add('hidden'); resultScreen.classList.add('hidden');
            mainScreen.classList.remove('hidden');
        }

        function showPipelineResult(data) {
            loadingScreen.classList.add('hidden'); resultScreen.classList.remove('hidden');
            const c = data.classification;
            const p = data.pipeline;
            const d = data.decision;
            const details = data.decision_details;
            const labels = data.decision_labels;
            const badgeClass = {'ready_to_sign':'ready','review_recommended':'review','high_risk':'high'};
            const isDebug = window.location.search.includes('debug=1');
            const supportLevel = c.supported ? 'Full' : 'Preview';

            let html = `<h2>📄 Document Understanding</h2>`;
            html += `<div class="card">`;
            html += `<p style="font-size:1.2rem;font-weight:600;">${c.display_name}</p>`;
            html += `<p style="font-size:0.9rem;color:#71717a;">Confidence: ${Math.round(c.confidence*100)}%</p>`;
            html += `<p style="font-size:0.9rem;color:#a1a1aa;">Support Level: ${supportLevel}</p>`;
            html += `</div>`;

            const readingTime = p.estimated_reading_time_min;
            const readingTimeStr = readingTime < 2 ? `${Math.round(readingTime * 60)} sec` : `${readingTime} min`;

            html += `<h2 style="font-size:1.2rem;">📋 Document Information</h2>`;
            html += `<div class="card"><div class="meta-grid">`;
            html += `<div class="meta-item"><div class="label">Language</div><div class="value">${p.language}</div></div>`;
            html += `<div class="meta-item"><div class="label">Pages</div><div class="value">${p.pages}</div></div>`;
            html += `<div class="meta-item"><div class="label">Reading Time</div><div class="value">${readingTimeStr}</div></div>`;
            html += `<div class="meta-item"><div class="label">Analysis Mode</div><div class="value">${supportLevel}</div></div>`;
            html += `</div></div>`;

            html += `<h2 style="font-size:1.2rem;">🔍 Analysis</h2>`;
            html += `<div class="card">`;

            if (d && details) {
                html += `<p style="font-size:1.1rem;font-weight:600;margin-bottom:12px;">Suggested decision:</p>`;
                html += `<span class="badge ${badgeClass[d]}">${labels[d]}</span>`;
                const factorsCount = details.all_findings ? details.all_findings.length : 0;
                html += `<p style="margin-top:8px;color:#a1a1aa;font-size:0.9rem;">Rule-based analysis (${factorsCount} factors detected)</p>`;

                if (details.top_reasons && details.top_reasons.length > 0) {
                    html += `<p class="section-title">Top reasons</p>`;
                    html += `<ul class="list">`;
                    details.top_reasons.forEach(r => {
                        html += `<li><strong>${r.factor}</strong> — ${r.reason}</li>`;
                    });
                    html += `</ul>`;
                }

                if (details.all_findings && details.all_findings.length > 0) {
                    html += `<p class="section-title">Detected issues (${factorsCount})</p>`;
                    details.all_findings.forEach(f => {
                        html += `<div class="finding-detail">`;
                        html += `<strong>${f.type.replace(/_/g, ' ')}</strong>`;
                        if (f.llm_reason) html += `<div class="llm-label">What it means</div><div class="llm-text">${f.llm_reason}</div>`;
                        if (f.llm_impact) html += `<div class="llm-label">Potential impact</div><div class="llm-text">${f.llm_impact}</div>`;
                        if (f.llm_suggested_rewrite) {
                            html += `<div class="llm-label">Suggested wording</div><div class="llm-text">${f.llm_suggested_rewrite}</div>`;
                            html += `<button class="copy-btn" data-text="${f.llm_suggested_rewrite.replace(/"/g, '&quot;')}">📋 Copy suggested wording</button>`;
                        }
                        html += `</div>`;
                    });
                }

                html += `<p style="margin-top:12px;font-size:0.8rem;color:#71717a;">Based on the terms detected in this document. This is not legal advice.</p>`;
            } else {
                if (!c.supported) {
                    html += `<div class="notice">⚠️ Full decision analysis is only available for Service Agreements. This document is in Preview mode.</div>`;
                    html += `<p class="section-title">Supported for full decision analysis</p>`;
                    html += `<ul class="list"><li>✓ Service Agreement</li></ul>`;
                    html += `<p class="section-title coming-soon">Coming soon</p>`;
                    html += `<ul class="list coming-soon"><li>• NDA</li><li>• Employment Contract</li><li>• Residential Tenancy Agreement</li></ul>`;
                }
                html += `<p class="section-title">Key Topics Detected (${c.key_clauses_found.length})</p>`;
                html += `<ul class="list">${c.key_clauses_found.length ? c.key_clauses_found.map(topic => `<li>✓ ${topic.charAt(0).toUpperCase() + topic.slice(1)}</li>`).join('') : '<li>None</li>'}</ul>`;
            }
            html += `</div>`;

            html += `<div class="whats-next">`;
            html += `<p style="font-weight:600;margin-bottom:8px;">What's next?</p>`;
            if (d && details) {
                html += `<p style="color:#a1a1aa;">Ready to use this on a real contract?</p>`;
                html += `<p><a href="#" onclick="showMain()">← Analyze another contract</a></p>`;
                html += `<div id="early-access-block" style="margin-top:12px;"></div>`;
            } else {
                html += `<p style="color:#a1a1aa;">This document type is in Preview mode.</p>`;
                html += `<p><a href="#" onclick="showMain()">← Upload a different document</a></p>`;
                html += `<p><a href="#" onclick="loadDemo('safe')">Try a Service Agreement demo</a></p>`;
            }
            html += `</div>`;

            html += `<div class="card" style="margin-top:16px;">`;
            html += `<p style="font-weight:600;">Was this useful?</p>`;
            html += `<div class="feedback-buttons" id="useful-buttons">`;
            html += `<button class="feedback-btn" data-useful="yes">👍 Yes</button>`;
            html += `<button class="feedback-btn" data-useful="no">👎 No</button>`;
            html += `</div>`;
            html += `<p style="font-weight:600;margin-top:16px;">What did you do next?</p>`;
            html += `<div class="feedback-buttons" id="action-buttons">`;
            html += `<button class="feedback-btn" data-action="signed">Signed it</button>`;
            html += `<button class="feedback-btn" data-action="changes">Asked for changes</button>`;
            html += `<button class="feedback-btn" data-action="walked">Walked away</button>`;
            html += `<button class="feedback-btn" data-action="deciding">Still deciding</button>`;
            html += `</div>`;
            html += `</div>`;

            if (isDebug) {
                html += `<div class="debug-info"><strong>Developer Info</strong><br>`;
                html += `Characters: ${p.text_length}<br>Processing time: ${p.processing_time_sec}s<br>Parser: ${p.parser}<br>`;
                if (details) {
                    html += `Total risk weight: ${details.total_weight}<br>Factors: ${factorsCount}<br>Engine: ServiceAgreementEngine v0.1<br>Detector: RuleDetector v0.1`;
                }
                html += `</div>`;
            }

            resultScreen.innerHTML = html;

            document.querySelectorAll('#useful-buttons .feedback-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('#useful-buttons .feedback-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    sendFeedback(null, this.dataset.useful);
                    if (this.dataset.useful === 'yes' && d && details) {
                        showEarlyAccess();
                    }
                });
            });
            document.querySelectorAll('#action-buttons .feedback-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('#action-buttons .feedback-btn').forEach(b => b.classList.remove('selected'));
                    this.classList.add('selected');
                    sendFeedback(this.dataset.action, null);
                });
            });

            // Кнопки копирования
            document.querySelectorAll('.copy-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const text = this.dataset.text.replace(/&quot;/g, '"');
                    navigator.clipboard.writeText(text).then(() => {
                        this.textContent = '✅ Copied!';
                        this.classList.add('copied');
                        setTimeout(() => {
                            this.textContent = '📋 Copy suggested wording';
                            this.classList.remove('copied');
                        }, 2000);
                    });
                });
            });
        }

        function showEarlyAccess() {
            const block = document.getElementById('early-access-block');
            if (!block) return;
            block.innerHTML = `
                <p style="color:#fbbf24;margin-bottom:8px;">Want to use this on your next contract?</p>
                <p style="color:#a1a1aa;font-size:0.9rem;">We're preparing early access for small agencies.</p>
                <button class="early-access-btn" onclick="showEmailForm()">Join Early Access</button>
                <div id="email-form-block" style="margin-top:8px;"></div>
            `;
        }

        function showEmailForm() {
            const formBlock = document.getElementById('email-form-block');
            if (!formBlock) return;
            formBlock.innerHTML = `
                <input type="email" id="early-email" placeholder="your@email.com" style="padding:10px;border-radius:8px;border:1px solid #27272a;background:#0f0f13;color:#e4e4e7;width:100%;margin:8px 0;">
                <button class="early-access-btn" onclick="submitEarlyAccess()">Notify me</button>
            `;
        }

        async function submitEarlyAccess() {
            const email = document.getElementById('early-email')?.value;
            if (!email || !email.includes('@')) { alert('Please enter a valid email.'); return; }
            try {
                await fetch('/early-access', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ visitor_id: visitorId, email: email })
                });
                document.getElementById('email-form-block').innerHTML = '<p style="color:#6ee7b7;">✅ Thank you! We\'ll let you know when early access opens.</p>';
            } catch (err) {
                alert('Something went wrong. Please try again.');
            }
        }

        function showError(msg) {
            loadingScreen.classList.add('hidden'); resultScreen.classList.remove('hidden');
            resultScreen.innerHTML = `<h2 style="color:#f87171;">⚠️ Error</h2><p style="color:#a1a1aa;">${msg}</p><p style="margin-top:20px;"><button class="upload-btn" onclick="showMain()">← Try again</button></p>`;
        }

        function showResult(data) {
            loadingScreen.classList.add('hidden'); resultScreen.classList.remove('hidden');
            const decisionLabels = {'safe_to_sign':'✅ Ready to Sign','sign_after_changes':'🟡 Review Recommended','do_not_sign':'🔴 High Risk'};
            const badgeClass = {'safe_to_sign':'ready','sign_after_changes':'review','do_not_sign':'high'};
            let html = `<div class="card"><span class="badge ${badgeClass[data.decision]}">${decisionLabels[data.decision]}</span>`;
            html += `<p style="margin-top:12px;color:#a1a1aa;">Confidence: ${Math.round(data.confidence*100)}%</p>`;
            html += `<ul class="list">${data.top_reasons.map(r => `<li><strong>${r.factor}</strong> — ${r.reason}</li>`).join('')}</ul></div>`;
            html += `<p style="margin-top:20px;"><button class="upload-btn" onclick="showMain()">← Back</button></p>`;
            resultScreen.innerHTML = html;
        }

        function sendFeedback(action, useful) {
            fetch('/feedback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ visitor_id: visitorId, action: action, useful: useful })
            }).catch(() => {});
        }
    </script>
</body>
</html>
